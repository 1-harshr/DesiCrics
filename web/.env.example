# Copy to .env.local and fill in. These end up in the browser, so nothing here is secret.

# The Ktor server. Locally: ./gradlew :server:run, started with WEB_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Firebase web app config: Firebase console › Project settings › Your apps › Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=desicrics-45117
VITE_FIREBASE_APP_ID=
